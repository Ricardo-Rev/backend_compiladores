    <!-- ── Credencial PDF (CredentialService) ─────────────── -->
    <PackageReference Include="itext7" Version="8.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Svg.Skia" Version="3.6.0" />
    <PackageReference Include="Twilio" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup> 
    <ProjectReference Include="..\umg_basic_rover_application\umg_basic_rover_application.csproj" />
    <ProjectReference Include="..\umg_basic_rover_domain\umg_basic_rover_domain.csproj" />
    <EmbeddedResource Include="Resources\fondo_credencial.jpg" />
  </ItemGroup>

</Project>
