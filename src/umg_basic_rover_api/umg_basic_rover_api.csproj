<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- ✅ Corregido: net9.0 → net8.0 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <!-- ✅ Corregido: 9.0.3 → 8.0.0 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <!-- ✅ Corregido: 9.0.9 → 8.0.20 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.20" />
    <!-- ✅ Corregido: 9.0.3 → 8.0.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <!-- ✅ Corregido: 9.0.3 → 8.0.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ✅ Compatible con .NET 8, sin cambio -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\umg_basic_rover_application\umg_basic_rover_application.csproj" />
    <ProjectReference Include="..\umg_basic_rover_infrastructure\umg_basic_rover_infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="haarcascade_frontalface_default.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
